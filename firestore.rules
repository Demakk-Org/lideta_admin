rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // NOTE: the wildcard above is named `db`, so every get() below must say
    // $(db). Writing $(database) leaves the variable unbound, which makes the
    // path invalid and silently denies the rule.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // ADMIN can counsel too: `role` holds a single value.
    function isCounselor() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('role', null)
          in ['COUNSELOR', 'ADMIN'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profiles stay readable to members: study chat shows other members' names.
    // `role` is admin-only, or anyone could make themselves an admin.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (isOwner(uid) && !('role' in request.resource.data));
      allow update: if isAdmin() || (isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Owner-only subcollections (meta/streak, daily_verse_reads, notifications…).
    // `{sub}` keeps this from matching the profile doc itself.
    match /users/{uid}/{sub}/{document=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // App-global content: read for any signed-in user,
    // writes go through admin console / cloud functions.
    match /daily_verse/{docId}             { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /news/{docId}                    { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /videos/{docId}                  { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /events/{docId}                  { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /event_categories/{docId}        { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /notifications/{docId}           { allow read: if request.auth != null; }
    match /bible/{docId}                   { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /bible_sources/{docId}           { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /books/{docId}                   { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /quizzes/{docId}                 { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /courses/{docId}                 { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /courses/{courseId}/lessons/{docId} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /course_categories/{docId}       { allow read: if request.auth != null; allow write: if isAdmin(); }
    // Doc id is `{courseId}:{uid}`; resource == null lets the app probe a course it hasn't started.
    match /course_progress/{docId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && docId == request.resource.data.courseId + ':' + request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /quiz_categories/{docId}         { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /quiz_attempts/{docId}           { allow read, write: if request.auth != null; }
    match /audios/{docId}                  { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /worship_documents/{docId}       { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /worship_groups/{docId}          { allow read: if request.auth != null; allow write: if isAdmin(); }
    // About page: the app reads only `published`; the draft never leaves the dashboard.
    match /about_page/published            { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /about_page/draft                { allow read, write: if isAdmin(); }
    match /bible_studies/{docId}           { allow read, write, update: if request.auth != null; }
    match /bible_study_groups/{docId}      { allow read, update: if request.auth != null; allow create: if isAdmin();}
    match /bible_study_categories/{docId}  { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /quiz_categories/{docId}         { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /bible_study_groups/{groupId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /quizzes/{quizId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // A member reads and writes only their own block list. Private to them —
    // the blocked member must never be able to see that they were blocked.
    match /users/{userId}/blocked_users/{blockedUserId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone signed in may file a report; only admins read or triage them.
    // Pinning reporterUserId and status stops a member filing under someone
    // else's name or self-marking a report as already reviewed.
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterUserId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Written only by the intake API through the admin SDK, which bypasses
    // rules, so this can stay fully closed to clients.
    match /deletion_requests/{id} {
      allow read, write: if isAdmin();
    }

    // Feature switches. Readable by anyone, signed in or not: the app reads
    // them at the splash screen, before login. Only admins write, and every
    // write must bump `version` by exactly one so two admins saving at once
    // can't silently overwrite each other.
    // App feature control. The app reads ONLY `app_settings/published`.
    // Admins edit numbered versions and publish one; the publish is a single
    // transaction that copies the version's features here, marks it published,
    // archives the previous one and logs it. getAfter() ties those writes
    // together, so the published doc can't hold features no version has.
    match /app_settings/published {
      function validPublished() {
        let d = request.resource.data;
        let v = getAfter(/databases/$(db)/documents/app_settings/published/versions/$(string(d.version))).data;
        return d.keys().hasOnly(['features', 'version', 'updatedAt', 'publishedBy'])
          && d.features is map
          && d.version is int
          && d.updatedAt == request.time
          && d.publishedBy == request.auth.uid
          && v.status == 'published'
          && v.features == d.features;
      }

      // Read at the splash screen, before sign-in.
      allow read: if true;
      allow create, update: if isAdmin() && validPublished();

      // Doc id is the version number. Only drafts can change features or be
      // deleted; published and archived versions only move between statuses.
      match /versions/{versionId} {
        function publishedVersionAfter() {
          return getAfter(/databases/$(db)/documents/app_settings/published).data.version;
        }

        allow read: if isAdmin();

        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly([
               'version', 'status', 'features', 'note', 'basedOn', 'revision',
               'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
          && request.resource.data.version == int(versionId)
          && request.resource.data.status == 'draft'
          && request.resource.data.features is map
          && request.resource.data.note is string
          && (request.resource.data.basedOn == null || request.resource.data.basedOn is int)
          && request.resource.data.revision == 1
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow update: if isAdmin() && (
          // Save a draft.
          (resource.data.status == 'draft'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['features', 'note', 'revision', 'updatedBy', 'updatedAt'])
            && request.resource.data.features is map
            && request.resource.data.note is string
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time)
          // Publish a draft, or publish an archived version again (rollback).
          || (resource.data.status in ['draft', 'archived']
            && request.resource.data.status == 'published'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'publishedBy', 'publishedAt'])
            && request.resource.data.publishedBy == request.auth.uid
            && request.resource.data.publishedAt == request.time
            && publishedVersionAfter() == resource.data.version)
          // Archive the version another publish replaced.
          || (resource.data.status == 'published'
            && request.resource.data.status == 'archived'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && publishedVersionAfter() != resource.data.version)
        );

        allow delete: if isAdmin() && resource.data.status == 'draft';
      }

      // Publish log, append-only.
      match /history/{entryId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['version', 'fromVersion', 'changed', 'publishedBy', 'publishedAt'])
          && request.resource.data.changed is map
          && (request.resource.data.fromVersion == null || request.resource.data.fromVersion is int)
          && request.resource.data.publishedBy == request.auth.uid
          && request.resource.data.publishedAt == request.time
          && request.resource.data.version ==
               getAfter(/databases/$(db)/documents/app_settings/published).data.version;
      }
    }

    // Pre-versioning single document. Read-only; the seed imports it as the
    // first version. Remove once no released app build reads it.
    match /app_settings/default {
      allow read: if true;
    }

    // A message may be deleted by its sender OR by the leader of its group.
    match /bible_study_groups/{groupId}/bible_studies/{studyId}/messages/{messageId} {
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        get(/databases/$(db)/documents/bible_study_groups/$(groupId)).data.leader == request.auth.uid
      );
    }

    // ── Counseling ──
    // Requesters are known only by the `cid` claim set by the backend; the
    // uid → cid mapping and audit log never reach a client. Staff docs carry a
    // per-request key, so staff can't link one person's requests. Admins
    // triage requests but cannot read sessions. All request/session writes go
    // through callables.
    function myCid() {
      return request.auth != null ? request.auth.token.get('cid', null) : null;
    }

    // Must mirror requesterKey() in cloud_functions counseling/shared.ts.
    function isRequester(data, requestId) {
      return myCid() != null
        && data.requesterKey == hashing.sha256(myCid() + ':' + requestId).toHexString().lower();
    }

    function isCurrentCounselor(data) {
      return request.auth != null
        && data.assignedCounselorId == request.auth.uid
        && isCounselor();
    }

    match /counseling_identity_mappings/{id} { allow read, write: if false; }
    match /counseling_audit_logs/{id}        { allow read, write: if false; }

    match /counseling_requests/{requestId} {
      // Requesters fetch by id; their list comes from listMyCounselingRequests.
      allow get: if isAdmin() || isRequester(resource.data, requestId) || isCurrentCounselor(resource.data);
      allow list: if isAdmin() || isCurrentCounselor(resource.data);
      allow write: if false;
    }

    match /counseling_sessions/{sessionId} {
      function session() {
        return get(/databases/$(db)/documents/counseling_sessions/$(sessionId)).data;
      }

      allow get: if isRequester(resource.data, sessionId) || isCurrentCounselor(resource.data);
      allow list: if isCurrentCounselor(resource.data);
      allow write: if false;

      // Read through the session doc, so a reassignment revokes the old counselor at once.
      match /messages/{messageId} {
        function validMessage(d) {
          return d.keys().hasOnly(['senderId', 'senderType', 'content', 'timestamp',
                   'isEdited', 'isSystem', 'attachments', 'mentionedUserIds',
                   'replyToMessageId', 'type'])
            && d.content is string && d.content.size() > 0 && d.content.size() <= 4000
            && d.timestamp == request.time
            && d.isEdited == false && d.isSystem == false
            && d.attachments == [] && d.mentionedUserIds == []
            && d.get('replyToMessageId', null) == null
            && d.type == 'text';
        }

        allow read: if isRequester(session(), sessionId) || isCurrentCounselor(session());
        allow create: if session().status == 'active'
          && validMessage(request.resource.data)
          && ((isRequester(session(), sessionId)
                && request.resource.data.senderType == 'requester'
                && request.resource.data.senderId == session().alias)
            || (isCurrentCounselor(session())
                && request.resource.data.senderType == 'counselor'
                && request.resource.data.senderId == request.auth.uid));
        allow update, delete: if false;
      }
    }
  }
}
